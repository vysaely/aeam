+// AEAM: swaps Roblox's shift-lock icon for a custom one as it is uploaded to the GPU (aeam_texture_swap.cc).
+#pragma once
+
+namespace aeam_texture_swap {
+
+// With MOCKTAIL_SHIFTLOCK_CURSOR and MOCKTAIL_SHIFTLOCK_ORIGINAL set and readable, arms the swap and returns the
+// wrappers to register in place of glTexImage2D and glTexSubImage2D; false leaves Roblox's own functions.
+bool Install(void* real_tex_image, void* real_tex_sub_image, void* real_get_integerv, void** tex_image,
+             void** tex_sub_image);
+
+}  // namespace aeam_texture_swap
