+
+void SdlPointerCaptureBackend::WarpToCentre() {
+  auto* window = static_cast<SDL_Window*>(window_);
+  int w = 0;
+  int h = 0;
+  if (window != nullptr && SDL_GetWindowSize(window, &w, &h)) {
+    // in relative mode on Wayland this moves the locked pointer's hint, which
+    // is where the compositor draws it
+    SDL_WarpMouseInWindow(window, w / 2.0f, h / 2.0f);
+  }
+}
+
+bool SdlPointerCaptureBackend::SetLockCursorImage(const char* png_path) {
+  if (png_path == nullptr || png_path[0] == '\0') {
+    return false;
+  }
+  SDL_Surface* surface = SDL_LoadPNG(png_path);
+  if (surface == nullptr) {
+    std::fprintf(stderr, "  [input] shift-lock cursor %s unavailable: %s\n",
+                 png_path, SDL_GetError());
+    return false;
+  }
+  SDL_Cursor* cursor =
+      SDL_CreateColorCursor(surface, surface->w / 2, surface->h / 2);
+  SDL_DestroySurface(surface);
+  if (cursor == nullptr) {
+    return false;
+  }
+  if (lock_cursor_ != nullptr) {
+    SDL_DestroyCursor(static_cast<SDL_Cursor*>(lock_cursor_));
+  }
+  lock_cursor_ = cursor;
+  return true;
+}
+
+void SdlPointerCaptureBackend::UseLockCursor(bool on) {
+  if (on == use_lock_cursor_ || lock_cursor_ == nullptr) {
+    return;
+  }
+  use_lock_cursor_ = on;
+  SDL_Cursor* arrow = cursor_ != nullptr ? static_cast<SDL_Cursor*>(cursor_)
+                                         : SDL_GetDefaultCursor();
+  SDL_SetCursor(on ? static_cast<SDL_Cursor*>(lock_cursor_) : arrow);
+  if (on && relative_mode_) {
+    WarpToCentre();
+  }
+  std::fprintf(stderr, "  [input] shift-lock cursor %s\n", on ? "shown" : "hidden");
 }
 
