+// The register a "mov r32, [rip + disp32]" (optional REX without W) at `at`
+// loads the flag value into, or -1.
+int LoadedRegister(const unsigned char* at, uintptr_t value) {
+  int rex = 0;
+  if (at[0] >= 0x40 && at[0] <= 0x47) {
+    rex = at[0];
+    ++at;
+  }
+  if (at[0] != 0x8b || (at[1] & 0xc7) != 0x05 ||
+      reinterpret_cast<uintptr_t>(at) + 6 + ReadDisplacement(at + 2) != value) {
+    return -1;
+  }
+  return ((at[1] >> 3) & 7) | ((rex & 4) << 1);
+}
+
+// AEAM: a 240 clamp of the flag value. "mov r32, 240" then "cmp" of that
+// register with another (optional REX), then a cmov; the other register was
+// loaded from the flag within 160 bytes before. Roblox 2.742 moved one clamp
+// to r12d with the load ~80 bytes earlier ("mov eax, 240; cmp r12d, eax;
+// cmovae r12d, eax"), which the fixed ecx/eax pattern missed.
+bool IsFlagClamp(const unsigned char* clamp, uintptr_t value) {
+  if (clamp[0] < 0xb8 || clamp[0] > 0xbf || clamp[1] != 0xf0 ||
+      clamp[2] != 0 || clamp[3] != 0 || clamp[4] != 0) {
+    return false;
+  }
+  const int imm = clamp[0] - 0xb8;
+  const unsigned char* p = clamp + 5;
+  int rex = 0;
+  if (*p == 0x41 || *p == 0x44 || *p == 0x45) {
+    rex = *p++;
+  }
+  if (p[0] != 0x39 || (p[1] >> 6) != 3) {
+    return false;
+  }
+  const int reg = ((p[1] >> 3) & 7) | ((rex & 4) << 1);
+  const int rm = (p[1] & 7) | ((rex & 1) << 3);
+  if (imm != reg && imm != rm) {
+    return false;
+  }
+  const int other = imm == reg ? rm : reg;
+  const unsigned char* q = p + 2;
+  if (*q == 0x41 || *q == 0x44 || *q == 0x45) {
+    ++q;
+  }
+  if (q[0] != 0x0f || !(q[1] == 0x4c || q[1] == 0x43 || q[1] == 0x4f ||
+                        q[1] == 0x42 || q[1] == 0x4e || q[1] == 0x46)) {
+    return false;
+  }
+  for (std::size_t back = 6; back <= 160; ++back) {
+    if (LoadedRegister(clamp - back, value) == other) {
       return true;
     }
   }
