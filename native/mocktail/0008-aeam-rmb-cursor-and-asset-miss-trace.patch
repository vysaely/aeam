diff --git a/src/window/window.cc b/src/window/window.cc
--- a/src/window/window.cc
+++ b/src/window/window.cc
@@ -966,6 +966,9 @@
     const bool image_ok =
         g_pointer_capture_backend->SetCursorImage(arrow.c_str(), 32, 32);
     g_pointer_capture_owner->SetHostCursorEnabled(true);
+    // SDL hides the cursor in relative mode unless told otherwise; the
+    // capture owner decides visibility itself (RMB drag keeps it shown).
+    SDL_SetHint(SDL_HINT_MOUSE_RELATIVE_CURSOR_VISIBLE, "1");
     fprintf(stderr, "  [input] host hardware cursor enabled (%s)\n",
             image_ok ? "Roblox arrow" : "system arrow");
   }
diff --git a/src/window/window_pointer_capture_owner.cc b/src/window/window_pointer_capture_owner.cc
--- a/src/window/window_pointer_capture_owner.cc
+++ b/src/window/window_pointer_capture_owner.cc
@@ -105,8 +105,13 @@
   // When capture is released, Roblox still draws its own cursor.
   // Show the system pointer only when the native client cannot provide one,
   // unless host cursor mode replaced Roblox's software arrow.
+  // AEAM: in host cursor mode a right-button camera drag keeps the cursor
+  // on screen, held where it was (owner request 2026-11-06); Shift Lock and
+  // other native locks still hide it.
+  const bool right_drag_only = capture_requested && !native_capture_active;
   const bool cursor_visible =
-      (!client_active || host_cursor_enabled_) && !capture_requested;
+      ((!client_active || host_cursor_enabled_) && !capture_requested) ||
+      (host_cursor_enabled_ && right_drag_only);
   return Apply(capture_requested, cursor_visible);
 }
 
